generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Category {
  id               Int                @id @default(autoincrement())
  name             String             @unique @db.VarChar(100)
  courseCategories CourseCategory[]

  @@map("categories")
}

model Course {
  id               Int                @id @default(autoincrement())
  title            String             @db.VarChar(255)
  rating           Decimal            @db.Decimal(3, 1)
  description      String             @db.Text
  image_url        String             @db.VarChar(255)
  course_url       String             @db.VarChar(255)
  created_at       DateTime?          @default(now()) @db.Timestamp(0)
  courseCategories CourseCategory[]

  @@map("courses")
}

model CourseCategory {
  course_id   Int
  category_id Int
  course      Course   @relation(fields: [course_id], references: [id], onDelete: Cascade)
  category    Category @relation(fields: [category_id], references: [id], onDelete: Cascade)

  @@id([course_id, category_id])
  @@map("course_categories")
}

model ChatSession {
  id              String     @id @default(uuid()) @db.VarChar(36)
  user_identifier String?    @db.VarChar(255)
  created_at      DateTime?  @default(now()) @db.Timestamp(0)
  updated_at      DateTime?  @default(now()) @updatedAt @db.Timestamp(0)
  messages        Message[]

  @@map("chat_sessions")
}

model Message {
  id         Int         @id @default(autoincrement())
  session_id String      @db.VarChar(36)
  role       MessageRole
  content    String      @db.Text
  created_at DateTime?   @default(now()) @db.Timestamp(0)
  session    ChatSession @relation(fields: [session_id], references: [id], onDelete: Cascade)

  @@map("messages")
}

enum MessageRole {
  user
  assistant
  system
}

model UserRateLimit {
  ip           String   @id @db.VarChar(45)
  requestCount Int      @default(0)
  updatedAt    DateTime @updatedAt

  @@map("user_rate_limits")
}
